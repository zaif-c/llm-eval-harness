# Copy to .env and fill in. .env is gitignored; this file is not.

# =============================================================================
# Required
# =============================================================================

# OpenRouter API key: https://openrouter.ai/keys
# One key reaches every provider. The model id below selects which one answers.
OPENROUTER_API_KEY=sk-or-v1-...

# Model under test. Any OpenRouter id; the prefix picks the provider.
#   openai/gpt-4o-mini
#   anthropic/claude-sonnet-4
#   google/gemini-2.5-flash
# Overridden per run by --model.
EVAL_MODEL=openai/gpt-4o-mini

# =============================================================================
# Optional
# =============================================================================

# Model used by the LLM judge. Falls back to EVAL_MODEL when unset.
# Worth setting to a different model than EVAL_MODEL: a model judging its own
# output is a weaker check than a second opinion.
# Note that logprob-weighted scoring needs a provider that returns logprobs,
# which is mostly OpenAI models through OpenRouter. The judge falls back to
# parsing the SCORE: line automatically when they are unavailable.
# JUDGE_MODEL=openai/gpt-4o

# Sentence-transformers model for semantic similarity. Downloaded on first use.
# EMBEDDING_MODEL=all-MiniLM-L6-v2
